// ==========================================
// ZDOS // SOVEREIGN BLOCKCHAIN MAIN (ZLang)
// ==========================================

import ZDOSConsensus;
import ZDOSChainState;
import ZDOSTokenLedger;

pub fn main() -> int {
    system_log("=== AVVIO NODO ZDOS SOVEREIGN BLOCKCHAIN ===");

    // 1. Inizializzazione dello stato globale
    let mut chain_state = ZDOSChainState::init_genesis_state();

    // 2. Definizione dei conti di test
    let acc_sender = ZDOSTokenLedger::AccountBalance {
        address: "ZVT_MASTER_SOVEREIGN_99",
        zvt_balance: 100000,
        dsn_balance: 5000
    };

    let acc_recipient = ZDOSTokenLedger::AccountBalance {
        address: "ZVT_RECIPIENT_SECURE_88B",
        zvt_balance: 500,
        dsn_balance: 100
    };

    // 3. Esecuzione del trasferimento nativo
    ZDOSTokenLedger::transfer_tokens(acc_sender, acc_recipient, 2500, 50);

    // 4. Validazione e commit del blocco
    let new_block = ZDOSConsensus::ConsensusBlock {
        height: chain_state.current_height,
        prev_hash: chain_state.latest_hash,
        merkle_root: crypto_sha256_hex("ZDOS_TX_BATCH_PAYLOAD_001"),
        validator_signature: "sig_sovereign_valid_ed25519",
        timestamp: system_timestamp_ms()
    };

    if ZDOSConsensus::validate_incoming_block(new_block, chain_state.latest_hash) {
        chain_state = ZDOSChainState::apply_block(chain_state, new_block);
        system_log("Blockchain sincronizzata. Altezza corrente: " + string(chain_state.current_height));
    }

    system_log("=== ZDOS BLOCKCHAIN: Ciclo completato con successo ===");
    return 0;
}
